# Lead ingest endpoint from the tenant's page in Azoria Leads
# (https://leads.azoria.com.au/api/leads/lk_…). The contact form POSTs
# enquiries here. Leave unset to fall back to the Netlify Forms quote form.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Cloudflare Turnstile site key. Only rendered when a contact endpoint is also
# configured; pair it with the matching secret on the tenant in Azoria Leads,
# or verification is skipped server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
